with source as (
    select * from {{ source('hostfully_api', 'raw_rate_multipliers') }}
),

renamed as (
    select
        -- Generated ID for snapshot tracking (since raw table lacks one)
        'global_rates' as multiplier_id,

        -- multipliers (flattened from JSON)
        cast(json_value(AIRBNB, '$.value') as numeric) as airbnb_rate_multiplier,
        cast(json_value(GOOGLE, '$.value') as numeric) as google_rate_multiplier,
        cast(json_value(BOOKING_COM, '$.value') as numeric) as booking_dot_com_rate_multiplier

    from source
)

select * from renamed